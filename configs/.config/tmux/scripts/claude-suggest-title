#!/usr/bin/env bash
# Prints a specific tab name (max 20 chars) for a Claude pane, or nothing when there is
# nothing to name it from. Haiku reads the project folder, the latest prompts (slash
# command arguments included, pasted text and image tags stripped), the start of Claude's
# last reply and the current name, which it keeps unless the topic changed.
# Used by claude-auto-title (automatic names) and claude-rename-tab (prefix N).
# Usage: claude-suggest-title PANE_ID
set -uo pipefail

pane_id=$1

one_line() { tr '\n' ' ' | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//'; }

transcript=$(tmux show -pqv -t "$pane_id" @claude_transcript)
latest_prompt=$(tmux show -pqv -t "$pane_id" @claude_task)

transcript_prompts() {
  [[ -n $transcript && -f $transcript ]] || return 0
  jq -r 'select(.type == "user" and (.message.content | type) == "string")
         | .message.content
         | if test("<command-name>") then
             (capture("<command-name>(?<name>[^<]*)</command-name>").name) as $name
             | ((capture("<command-args>(?<args>[^<]*)</command-args>").args) // "") as $args
             | if ($args | test("\\S")) then "\($name) \($args)" else empty end
           else . end
         | gsub("<pasted_content[^>]*>[\\s\\S]*?</pasted_content>"; " [pasted text] ")
         | gsub("<system-reminder>[\\s\\S]*?</system-reminder>"; " ")
         | gsub("\\[Image #[0-9]+\\]"; " ")
         | gsub("\\s+"; " ") | sub("^ "; "")
         | select(test("\\S") and (startswith("<") | not))
         | .[0:300]' "$transcript" 2>/dev/null
}

recent_prompts() {
  local prompts
  prompts=$(transcript_prompts)
  if [[ -n $latest_prompt && $prompts != *"${latest_prompt:0:80}"* ]]; then
    prompts+=$'\n'$latest_prompt
  fi
  awk 'NF' <<<"$prompts" | tail -6
}

last_reply() {
  [[ -n $transcript && -f $transcript ]] || return 0
  jq -r 'select(.type == "assistant") | .message.content[]? | select(.type == "text") | .text' \
    "$transcript" 2>/dev/null | tail -c 2000 | one_line | cut -c1-300
}

prompts=$(recent_prompts | nl -w1 -s'. ')
[[ -n $prompts ]] || exit 0

project_folder=$(basename "$(tmux display -p -t "$pane_id" '#{pane_current_path}')")
current_name=$(tmux display -p -t "$pane_id" '#{E:@claude_title_full}')
[[ $current_name == "Claude Code" ]] && current_name="(none yet)"
reply=$(last_reply)

name=$(cd /tmp && env -u TMUX_PANE timeout 25 claude -p --model haiku --no-session-persistence \
  --strict-mcp-config --settings '{"disableAllHooks":true}' \
  "Name a coding session for a terminal tab.

Project folder: $project_folder
Current tab name: $current_name
Requests, oldest first, newest last:
$prompts
Start of the assistant's last reply: ${reply:-(none)}

Rules:
- Name the specific thing being worked on: the feature, bug, file, page, tool or topic. Good: \"Login redirect loop\", \"Cookie import to Zen\", \"Hero image regen\", \"YT video explainer\".
- Never a generic name that could fit any session: \"File rename\", \"Image review\", \"Code changes\", \"Bug fix\", \"Help request\".
- Don't repeat the project folder name; the tab already sits in that project.
- The newest topic wins over earlier ones. If the current tab name still fits the newest topic, reply with it unchanged.
- At most 20 characters including spaces, 2 to 4 words, no quotes, no trailing punctuation.
Reply with the name only." 2>/dev/null |
  one_line | tr -d '"`' | sed 's/[.!]$//')

[[ -n $name && ${#name} -le 40 ]] || exit 0

if (( ${#name} > 20 )); then
  name=${name:0:21}
  [[ $name == *" "* ]] && name=${name% *}
  name=${name:0:20}
fi
printf '%s\n' "$name"
