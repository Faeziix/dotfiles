#!/usr/bin/env python3
"""Builds a one-glyph font from assets/claude-logo.svg (simple-icons, CC0) at U+F6000 and installs it.

Nerd Fonts has no Claude logo, so tmux status text uses this private-use glyph.
Kitty finds it through fontconfig fallback.
"""
import subprocess
from pathlib import Path

from fontTools.fontBuilder import FontBuilder
from fontTools.pens.cu2quPen import Cu2QuPen
from fontTools.pens.transformPen import TransformPen
from fontTools.pens.ttGlyphPen import TTGlyphPen
from fontTools.svgLib.path import parse_path
from xml.etree import ElementTree

CODEPOINT = 0xF6000
UNITS_PER_EM = 1000
SVG_VIEWBOX_SIZE = 24
GLYPH_HEIGHT = 800
BASELINE_OFFSET = 0
LOGO_SVG = Path(__file__).resolve().parent.parent / "assets/claude-logo.svg"
OUTPUT = Path.home() / ".dotfiles/fonts/.local/share/fonts/claude-glyph/ClaudeGlyph.ttf"
INSTALL_LINK = Path.home() / ".local/share/fonts/claude-glyph"


def read_logo_path_data():
    root = ElementTree.parse(LOGO_SVG).getroot()
    namespace = {"svg": "http://www.w3.org/2000/svg"}
    return root.find("svg:path", namespace).attrib["d"]


def draw_logo():
    scale = GLYPH_HEIGHT / SVG_VIEWBOX_SIZE
    horizontal_offset = (UNITS_PER_EM - SVG_VIEWBOX_SIZE * scale) / 2
    glyph_pen = TTGlyphPen(None)
    flip_and_scale = (scale, 0, 0, -scale, horizontal_offset, GLYPH_HEIGHT + BASELINE_OFFSET)
    parse_path(read_logo_path_data(), TransformPen(Cu2QuPen(glyph_pen, max_err=1.0, reverse_direction=True), flip_and_scale))
    return glyph_pen.glyph()


def build_font():
    glyph_order = [".notdef", "claude"]
    builder = FontBuilder(UNITS_PER_EM, isTTF=True)
    builder.setupGlyphOrder(glyph_order)
    builder.setupCharacterMap({CODEPOINT: "claude"})
    empty = TTGlyphPen(None).glyph()
    builder.setupGlyf({".notdef": empty, "claude": draw_logo()})
    builder.setupHorizontalMetrics({".notdef": (UNITS_PER_EM, 0), "claude": (UNITS_PER_EM, 0)})
    builder.setupHorizontalHeader(ascent=900, descent=-200)
    builder.setupNameTable({"familyName": "Claude Glyph", "styleName": "Regular"})
    builder.setupOS2(sTypoAscender=900, sTypoDescender=-200, usWinAscent=900, usWinDescent=200)
    builder.setupPost()
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    builder.save(OUTPUT)


def install():
    if not INSTALL_LINK.exists():
        INSTALL_LINK.symlink_to(OUTPUT.parent)
    subprocess.run(["fc-cache", "-f", str(INSTALL_LINK)], check=True)


if __name__ == "__main__":
    build_font()
    install()
    print(f"glyph U+{CODEPOINT:X} installed from {OUTPUT}")
