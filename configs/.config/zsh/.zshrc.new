zmodload zsh/zprof
# ====================================
# ZSH Configuration File
# ====================================

# Initialize debugging/timing if enabled
source "$ZDOTDIR/lib/debug.zsh"

# Load core settings
source "$ZDOTDIR/lib/core.zsh"

# Load keybindings
source "$ZDOTDIR/keybindings/init.zsh"

# Load history configuration
source "$ZDOTDIR/lib/history.zsh"

# Load prompt configuration
source "$ZDOTDIR/lib/prompt.zsh"

# Load completion system
source "$ZDOTDIR/completion/init.zsh"

# Load color support
source "$ZDOTDIR/lib/colors.zsh"

# Load plugins
source "$ZDOTDIR/plugins/init.zsh"

# Load path configuration
source "$ZDOTDIR/lib/path.zsh"

# Load functions
for function_file in "$ZDOTDIR"/functions/*.zsh; do
  source "$function_file"
done

# Load aliases
source "$ZDOTDIR/.aliases"

# Bun completion
[ -s "/home/faezix/.bun/_bun" ] && source "/home/faezix/.bun/_bun"
